# Copy to .env and fill in. Never commit the real .env file.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Jakarta

# --- Database (PostgreSQL + TimescaleDB + pgvector) ---
# Port 5433, not 5432: avoids clashing with a native PostgreSQL install
# that may already be listening on 5432 (e.g. a Windows Postgres service).
DATABASE_URL=postgresql+psycopg://idx:idx@localhost:5433/idx_intelligence
POSTGRES_USER=idx
POSTGRES_PASSWORD=idx
POSTGRES_DB=idx_intelligence

# --- Orchestration (Prefect) ---
PREFECT_API_URL=http://localhost:4200/api

# --- Experiment tracking (MLflow) ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- LLM (narrative/explanation only -- never numeric computation, spec §2.15/§12) ---
# LLM_PROVIDER: "anthropic" | "openrouter" | "ollama" | "none"
LLM_PROVIDER=none
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
# Example free-tier config via OpenRouter (OpenAI-compatible, spec §12):
#   LLM_PROVIDER=openrouter
#   LLM_API_BASE=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=google/gemma-4-31b-it:free
# Free model IDs rotate -- verify against https://openrouter.ai/api/v1/models
# (no auth needed to list) before relying on one long-term.

# --- Data provider credentials (all optional; adapters must degrade gracefully without them) ---
NEWS_PROVIDER_API_KEY=
MARKET_DATA_PROVIDER_API_KEY=

# Market data adapters (Tahap 2). Both are real, documented, ToS-compliant
# APIs -- see docs/data_sources.md for what each actually covers/costs.
# Free signup: https://twelvedata.com/pricing ("absolutely free" tier confirmed live).
TWELVE_DATA_API_KEY=
# Paid only (no free tier as of this writing) -- https://sectors.app/pricing
SECTORS_APP_API_KEY=
# Real, free, documented API for BPS (Statistik Indonesia) macro series
# (inflation/CPI). Free registration: https://webapi.bps.go.id/developer/
BPS_API_KEY=
# Real, free, documented API for FRED (US Fed/global rates, research/
# cross-check only, never a substitute for Indonesia's own rates). Free
# registration: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
FUNDAMENTALS_PROVIDER=auto
# Path to a JSON manifest plus authorized/manual IDX XBRL downloads.
IDX_XBRL_MANIFEST_PATH=
# DCF_DISCOUNT_RATE=0.12
# DCF_NEAR_TERM_GROWTH_RATE=0.05
# DCF_TERMINAL_GROWTH_RATE=0.03
DCF_PROJECTION_YEARS=5
NEWS_USAGE_MODE=research
NEWS_SCHEDULE_HOUR=6
NEWS_SCHEDULE_MINUTE=0

# --- Market data provider selection (docs/provider_capabilities.md) ---
# MARKET_DATA_PROVIDER: "auto" (probe Twelve Data, fall back per usage mode) | "twelve_data" | "yahoo_finance"
MARKET_DATA_PROVIDER=auto
# MARKET_DATA_USAGE_MODE: "research" (Yahoo Finance fallback allowed) | "production" (licensed providers only)
MARKET_DATA_USAGE_MODE=research
ENABLE_YAHOO_FINANCE_FALLBACK=true
VERIFY_LATEST_PRICE_WITH_IDX=true
# PRICE_ADJUSTMENT_POLICY: raw | provider_split_adjusted | provider_all_adjusted | internally_verified_adjusted
PRICE_ADJUSTMENT_POLICY=provider_split_adjusted

# --- Rate limiting / retry for OHLCV ingestion ---
OHLCV_BATCH_SIZE=20
OHLCV_MAX_RETRIES=4
OHLCV_REQUEST_TIMEOUT_SECONDS=30
OHLCV_REQUEST_DELAY_SECONDS=2

# --- Cache (optional) ---
REDIS_URL=
